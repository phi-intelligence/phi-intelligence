# Application
NODE_ENV=development
PORT=5000

# Database
# SQLite (for local development - simple, no setup required)
DATABASE_URL=sqlite:///./phi_tms.db
# PostgreSQL (for production)
# DATABASE_URL=postgresql://phi_tms_user:phi_tms_password_2024@localhost:5433/phi_tms_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here

# CORS (comma-separated; optional — sensible dev defaults are built in if unset)
# Include Phi Intelligence dev (Express+Vite): http://localhost:5000 and http://localhost:5180
# CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:5180
